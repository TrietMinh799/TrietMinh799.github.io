---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Little tools I develop" description="A collection of small tools and utilities developed by Triet Minh.">
  <section class="stack" aria-labelledby="tools-title">
    <h1 id="tools-title">Little Tools</h1>
    <p class="lede">Những công cụ nhỏ mình phát triển để giải quyết một số bài toán thú vị.</p>
    
    <nav class="tools-navigation" aria-label="Danh sách công cụ">
      <ul class="tools-list">
        <li>
          <a href="/wordle_helper.github.io" class="tool-card">
            <span class="tool-name">Giải Wordle</span>
            <span class="tool-desc">Công cụ hỗ trợ tìm và đoán từ khóa trò chơi Wordle tiếng Việt/tiếng Anh.</span>
          </a>
        </li>
        <li>
          <a href="/sudoku_solver.github.io" class="tool-card">
            <span class="tool-name">Giải Sudoku</span>
            <span class="tool-desc">Giải các bàn cờ Sudoku một cách nhanh chóng bằng thuật toán tối ưu.</span>
          </a>
        </li>
      </ul>
    </nav>
  </section>
</BaseLayout>

<style>
  .tools-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    color: inherit;
  }

  .tool-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }

  .tool-desc {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
