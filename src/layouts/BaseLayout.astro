---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>{SITE_TITLE}</a>
        <nav aria-label="Primary navigation">
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>Built with Astro. Published from GitHub Pages.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f8f7f2;
    --paper: #fffdf8;
    --text: #1e201c;
    --muted: #64665f;
    --line: #dfddd3;
    --accent: #27615a;
    --accent-soft: #dbe9e5;
    --shadow: 0 24px 70px rgba(36, 35, 28, 0.08);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background:
      linear-gradient(180deg, rgba(219, 233, 229, 0.36), transparent 22rem),
      var(--bg);
    color: var(--text);
    font-size: 17px;
    line-height: 1.7;
  }

  a {
    color: inherit;
    text-decoration-color: rgba(39, 97, 90, 0.38);
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.18em;
  }

  a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .site-shell {
    width: min(100% - 2rem, 980px);
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 2rem 0 3rem;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  nav a {
    text-decoration: none;
  }

  h1,
  h2,
  h3 {
    line-height: 1.12;
    margin: 0;
    letter-spacing: 0;
  }

  h1 {
    max-width: 760px;
    font-size: clamp(2.4rem, 8vw, 5.7rem);
  }

  h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
  }

  h3 {
    font-size: 1.25rem;
  }

  p {
    margin: 0;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .lede {
    max-width: 680px;
    color: var(--muted);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
  }

  .section {
    padding: 3rem 0;
    border-top: 1px solid var(--line);
  }

  .stack {
    display: grid;
    gap: 1.15rem;
  }

  .post-list {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .post-card {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
  }

  .post-card a {
    width: fit-content;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }

  .meta {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.3rem;
  }

  .tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1;
    padding: 0.38rem 0.58rem;
  }

  .prose {
    max-width: 720px;
  }

  .prose > * + * {
    margin-top: 1.25rem;
  }

  .prose h2,
  .prose h3 {
    margin-top: 2.4rem;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.2rem;
  }

  .prose blockquote {
    border-left: 3px solid var(--accent);
    color: var(--muted);
    margin-left: 0;
    padding-left: 1rem;
  }

  .prose code {
    background: var(--accent-soft);
    border-radius: 0.25rem;
    font-size: 0.9em;
    padding: 0.1rem 0.3rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 4rem;
    padding: 2rem 0;
  }

  @media (max-width: 640px) {
    body {
      font-size: 16px;
    }

    .site-shell {
      width: min(100% - 1.25rem, 980px);
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      padding-bottom: 2.2rem;
    }
  }
</style>
