---
interface Props {
  id?: string;
  url?: string;
  title?: string;
}

const { id, url, title = "YouTube video player" } = Astro.props;

let videoId = id;
if (!videoId && url) {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
  if (match) videoId = match[1];
}
---

{
  videoId && (
    <div class="video-container">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${videoId}`}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
      />
    </div>
  )
}

<style>
  .video-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 1.75rem 0;
    border-radius: 10px;
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow);
  }

  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
