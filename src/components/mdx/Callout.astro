---
interface Props {
  type?: "note" | "tip" | "info" | "warning" | "danger" | "caution" | "success";
  title?: string;
}

const { type = "note", title } = Astro.props;

const normalizedType = type === "caution" ? "danger" : type;

const defaultTitles: Record<string, string> = {
  note: "Ghi chú",
  tip: "Mẹo nhỏ",
  info: "Thông tin",
  warning: "Lưu ý",
  danger: "Cảnh báo",
  success: "Thành công",
};

const displayTitle = title || defaultTitles[normalizedType] || "Lưu ý";
---

<div class={`callout callout-${normalizedType}`} role="note">
  <div class="callout-header">
    <span class="callout-icon" aria-hidden="true">
      {normalizedType === "note" && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      )}
      {normalizedType === "tip" && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
      )}
      {normalizedType === "info" && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      )}
      {normalizedType === "warning" && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
      )}
      {normalizedType === "danger" && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
      )}
      {normalizedType === "success" && (
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
      )}
    </span>
    <span class="callout-title">{displayTitle}</span>
  </div>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border-left: 4px solid;
    font-size: 0.95rem;
    line-height: 1.6;
    background: var(--callout-bg);
    border-color: var(--callout-border);
    color: var(--text);
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--callout-title-color);
  }

  .callout-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .callout-content > :first-child {
    margin-top: 0;
  }

  .callout-content > :last-child {
    margin-bottom: 0;
  }

  /* Variant colors with light/dark adaptive custom properties */
  .callout-note {
    --callout-bg: rgba(39, 97, 90, 0.08);
    --callout-border: #27615a;
    --callout-title-color: #1b4e48;
  }

  .callout-tip {
    --callout-bg: rgba(14, 165, 233, 0.08);
    --callout-border: #0284c7;
    --callout-title-color: #0369a1;
  }

  .callout-info {
    --callout-bg: rgba(99, 102, 241, 0.08);
    --callout-border: #6366f1;
    --callout-title-color: #4f46e5;
  }

  .callout-warning {
    --callout-bg: rgba(234, 179, 8, 0.1);
    --callout-border: #d97706;
    --callout-title-color: #b45309;
  }

  .callout-danger {
    --callout-bg: rgba(239, 68, 68, 0.1);
    --callout-border: #dc2626;
    --callout-title-color: #b91c1c;
  }

  .callout-success {
    --callout-bg: rgba(34, 197, 94, 0.1);
    --callout-border: #16a34a;
    --callout-title-color: #15803d;
  }

  :global([data-theme="dark"]) .callout-note {
    --callout-bg: rgba(90, 177, 163, 0.12);
    --callout-border: #5ab1a3;
    --callout-title-color: #7dd3c7;
  }
  :global([data-theme="dark"]) .callout-tip {
    --callout-bg: rgba(56, 189, 248, 0.12);
    --callout-border: #38bdf8;
    --callout-title-color: #7dd3fc;
  }
  :global([data-theme="dark"]) .callout-info {
    --callout-bg: rgba(129, 140, 248, 0.12);
    --callout-border: #818cf8;
    --callout-title-color: #a5b4fc;
  }
  :global([data-theme="dark"]) .callout-warning {
    --callout-bg: rgba(251, 191, 36, 0.12);
    --callout-border: #fbbf24;
    --callout-title-color: #fcd34d;
  }
  :global([data-theme="dark"]) .callout-danger {
    --callout-bg: rgba(248, 113, 113, 0.12);
    --callout-border: #f87171;
    --callout-title-color: #fca5a5;
  }
  :global([data-theme="dark"]) .callout-success {
    --callout-bg: rgba(74, 222, 128, 0.12);
    --callout-border: #4ade80;
    --callout-title-color: #86efac;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .callout-note {
      --callout-bg: rgba(90, 177, 163, 0.12);
      --callout-border: #5ab1a3;
      --callout-title-color: #7dd3c7;
    }
    :global(:root:not([data-theme="light"])) .callout-tip {
      --callout-bg: rgba(56, 189, 248, 0.12);
      --callout-border: #38bdf8;
      --callout-title-color: #7dd3fc;
    }
    :global(:root:not([data-theme="light"])) .callout-info {
      --callout-bg: rgba(129, 140, 248, 0.12);
      --callout-border: #818cf8;
      --callout-title-color: #a5b4fc;
    }
    :global(:root:not([data-theme="light"])) .callout-warning {
      --callout-bg: rgba(251, 191, 36, 0.12);
      --callout-border: #fbbf24;
      --callout-title-color: #fcd34d;
    }
    :global(:root:not([data-theme="light"])) .callout-danger {
      --callout-bg: rgba(248, 113, 113, 0.12);
      --callout-border: #f87171;
      --callout-title-color: #fca5a5;
    }
    :global(:root:not([data-theme="light"])) .callout-success {
      --callout-bg: rgba(74, 222, 128, 0.12);
      --callout-border: #4ade80;
      --callout-title-color: #86efac;
    }
  }
</style>
