---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length >= 2 && (
    <nav class="toc-container" aria-label="Mục lục bài viết">
      <details class="toc-details" open>
        <summary class="toc-summary">
          <span class="toc-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            Mục lục
          </span>
        </summary>
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li class={`toc-item depth-${heading.depth}`}>
              <a href={`#${heading.slug}`} class="toc-link">
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

<style>
  .toc-container {
    margin: 1.5rem 0 2rem 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    overflow: hidden;
  }

  .toc-details {
    padding: 0.75rem 1rem;
  }

  .toc-summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    user-select: none;
    list-style: none;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
  }

  .toc-list {
    margin: 0.75rem 0 0.25rem 0;
    padding-left: 1.25rem;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: 0.9rem;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
    font-size: 0.85rem;
  }

  .toc-link {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
