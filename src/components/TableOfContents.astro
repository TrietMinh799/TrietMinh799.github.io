---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length >= 2 && (
    <nav class="toc-container" id="table-of-contents" aria-label="Mục lục bài viết">
      <details class="toc-details" open>
        <summary class="toc-summary">
          <span class="toc-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            Mục lục bài viết
          </span>
          <span class="toc-active-hint" id="toc-active-hint"></span>
        </summary>
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li class={`toc-item depth-${heading.depth}`}>
              <a href={`#${heading.slug}`} class="toc-link" data-heading-id={heading.slug}>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}

<script>
  function initTocScrollSpy() {
    const tocContainer = document.getElementById("table-of-contents");
    if (!tocContainer || tocContainer.dataset.hasSpyListener) return;
    tocContainer.dataset.hasSpyListener = "true";

    const links = tocContainer.querySelectorAll<HTMLAnchorElement>(".toc-link");
    const activeHint = document.getElementById("toc-active-hint");
    if (!links.length) return;

    const headingMap = new Map<string, HTMLAnchorElement>();
    const headingElements: HTMLElement[] = [];

    links.forEach((link) => {
      const id = link.dataset.headingId;
      if (id) {
        headingMap.set(id, link);
        const el = document.getElementById(id);
        if (el) headingElements.push(el);
      }
    });

    function setActiveHeading(id: string) {
      links.forEach((l) => l.classList.remove("active"));
      const activeLink = headingMap.get(id);
      if (activeLink) {
        activeLink.classList.add("active");
        if (activeHint) {
          activeHint.textContent = `• ${activeLink.textContent?.trim()}`;
        }
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        // Find visible headings
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length > 0) {
          // Sort by position relative to top
          visible.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          setActiveHeading(visible[0].target.id);
        }
      },
      {
        rootMargin: "-80px 0px -60% 0px",
        threshold: [0, 1],
      }
    );

    headingElements.forEach((el) => observer.observe(el));
  }

  initTocScrollSpy();
  document.addEventListener("astro:page-load", initTocScrollSpy);
</script>

<style>
  .toc-container {
    margin: 1.5rem 0 2rem 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .toc-details {
    padding: 0.85rem 1.15rem;
  }

  .toc-summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    user-select: none;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .toc-summary::-webkit-details-marker {
    display: none;
  }

  .toc-title {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-weight: 700;
  }

  .toc-active-hint {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 250px;
  }

  .toc-list {
    margin: 0.85rem 0 0.25rem 0;
    padding-left: 0.5rem;
    list-style: none;
    display: grid;
    gap: 0.35rem;
    font-size: 0.9rem;
    border-left: 2px solid var(--line-subtle);
  }

  .toc-item {
    position: relative;
  }

  .toc-item.depth-3 {
    padding-left: 1rem;
    font-size: 0.85rem;
  }

  .toc-link {
    display: block;
    color: var(--muted);
    text-decoration: none;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .toc-link:hover {
    color: var(--text);
    background: var(--accent-soft);
    transform: translateX(2px);
  }

  .toc-link.active {
    color: var(--accent);
    font-weight: 600;
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    padding-left: calc(0.5rem - 3px);
  }
</style>
