<div id="reading-progress-bar" class="reading-progress-bar" aria-hidden="true">
  <div class="progress-indicator"></div>
</div>

<script>
  function initReadingProgress() {
    const progressBar = document.getElementById("reading-progress-bar");
    const indicator = progressBar?.querySelector<HTMLElement>(".progress-indicator");
    if (!progressBar || !indicator) return;

    let ticking = false;

    function updateProgress() {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) {
        progressBar!.style.opacity = "0";
        return;
      }

      const scrolled = window.scrollY;
      const progress = Math.min(Math.max((scrolled / docHeight) * 100, 0), 100);

      indicator!.style.transform = `scaleX(${progress / 100})`;
      progressBar!.style.opacity = scrolled > 50 ? "1" : "0";
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }

    window.removeEventListener("scroll", onScroll);
    window.addEventListener("scroll", onScroll, { passive: true });
    updateProgress();
  }

  initReadingProgress();
  document.addEventListener("astro:page-load", initReadingProgress);
</script>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .progress-indicator {
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: 0% 50%;
    transform: scaleX(0);
    transition: transform 0.08s linear;
    box-shadow: 0 0 8px var(--accent);
  }
</style>
