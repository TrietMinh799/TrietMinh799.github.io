---
---

<button
  type="button"
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Chuyển giao diện (Sáng / Đọc sách / Tối)"
  title="Chuyển giao diện: Sáng ☀️ → Đọc sách 📖 → Tối 🌙 [Phím tắt: T]"
>
  <!-- Sun icon (Light mode) -->
  <svg
    class="theme-icon icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Book icon (Sepia / Eye-comfort mode) -->
  <svg
    class="theme-icon icon-book"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
    <path d="M6 6h10"></path>
    <path d="M6 10h10"></path>
  </svg>

  <!-- Moon icon (Dark mode) -->
  <svg
    class="theme-icon icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  function initThemeToggle() {
    const toggle = document.getElementById("theme-toggle");
    if (!toggle || toggle.dataset.hasThemeListener) return;
    toggle.dataset.hasThemeListener = "true";

    function getEffectiveTheme(): "light" | "sepia" | "dark" {
      const explicit = document.documentElement.getAttribute("data-theme");
      if (explicit === "dark" || explicit === "sepia" || explicit === "light") {
        return explicit;
      }
      return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function cycleTheme() {
      const current = getEffectiveTheme();
      let next: "light" | "sepia" | "dark";
      if (current === "light") {
        next = "sepia";
      } else if (current === "sepia") {
        next = "dark";
      } else {
        next = "light";
      }

      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    }

    toggle.addEventListener("click", cycleTheme);

    // Global keyboard shortcut 'T' for theme toggle
    window.addEventListener("keydown", (e) => {
      if (
        (e.key === "t" || e.key === "T") &&
        !["INPUT", "TEXTAREA", "SELECT"].includes((e.target as HTMLElement)?.tagName)
      ) {
        cycleTheme();
      }
    });
  }

  initThemeToggle();
  document.addEventListener("astro:page-load", initThemeToggle);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.45rem;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: scale(1.05);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-icon {
    display: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default Light Mode */
  :global(:root:not([data-theme])) .icon-sun,
  :global([data-theme="light"]) .icon-sun {
    display: block;
  }

  /* Sepia Mode */
  :global([data-theme="sepia"]) .icon-book {
    display: block;
  }

  /* Dark Mode */
  :global([data-theme="dark"]) .icon-moon {
    display: block;
  }

  /* OS Dark mode fallback when no explicit attribute */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme])) .icon-sun {
      display: none;
    }
    :global(:root:not([data-theme])) .icon-moon {
      display: block;
    }
  }
</style>
